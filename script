# Coluna com J - Fator de correçãoo (Poulin, 2020)
# corrige tamanhos de amostra pequenos, dando mais peso as comparações com base em grandes amostras
ambiente$j <- 1 - (3/(4*(ambiente$horas_seca+ambiente$horas_chuvosa-2)-1))
