# Corrigindo o tipo das variáveis
data_ab_im <- data_ab_im %>% 
  mutate(id = as.factor(id),
         id_paper = as.factor(id_paper),
         tick_species = as.factor(tick_species),
         tick_stage = as.factor(tick_stage),
         host = as.factor(host),
         h_family = as.factor(h_family),
         index = as.factor(index),
         lat = as.numeric(lat))

#Selecionando variaveis de interesse
str(data_ab_im)
data_ab_im2 <- data_ab_im %>% 
  select(id, id_paper, author, year, h_family, index, hosp_seca, hosp_chuv,
         tick_species, tick_stage, n_tickseca, mean_seca, sd1, n_tickchuvosa, mean_chuvosa,
         sd2, log, lat, alt)

# Cálculo de Tamanho de efeito 
attach(data_ab_im2) 	# Adicionando 1 em todas medidas para evitar erro no modelo ###
data_ab_im2$mean_seca <- mean_seca + 1
data_ab_im2$n_tickseca <- n_tickseca + 1   
data_ab_im2$sd1 <- sd1 + 1                 
data_ab_im2$mean_chuvosa <- mean_chuvosa + 1 
data_ab_im2$n_tickchuvosa <- n_tickchuvosa + 1
data_ab_im2$sd2 <- sd2 + 1                    
# Calculo de Hedges' d
d <- ((data_ab_im2$mean_seca - data_ab_im2$mean_chuvosa) /
        sqrt(((data_ab_im2$n_tickseca - 1)*data_ab_im2$sd1^2 + 
                (data_ab_im2$n_tickchuvosa - 1)*data_ab_im2$sd2^2)/
               (data_ab_im2$n_tickseca + data_ab_im2$n_tickchuvosa - 2)))*
  (1 - 3 / (4 *(data_ab_im2$n_tickseca + data_ab_im2$n_tickchuvosa - 2) - 1))
summary(d)
hist(d)
data_ab_im2['d'] <- c(d)
# Calculating the r value
r = data_ab_im2$d /
  (sqrt(data_ab_im2$d^2 + 
          (((data_ab_im2$n_tickseca + data_ab_im2$n_tickchuvosa)^2)/
             (data_ab_im2$n_tickseca*data_ab_im2$n_tickchuvosa))))
summary(r)
# Calculating Zr
Zr = 0.5 * log((1 + r) / (1 - r))
summary(Zr)
hist(Zr)
data_ab_im2['Zr'] <- c(Zr)
# Calculating the sampling variance
Zrsv <- 1 / (data_ab_im2$n_tickseca + data_ab_im2$n_tickchuvosa - 3)
data_ab_im2['Zrsv'] <- c(Zrsv)
summary(Zrsv)
hist(Zrsv)
# Correcting some sampling variances
# In order to obtain sampling variances, some values were initially divided by zero. I thus transform them into 1.00, which is the maximum possible value for the sampling variance in this case
data_ab_im2$Zrsv[data_ab_im2$Zrsv == "Inf"] <- 1
