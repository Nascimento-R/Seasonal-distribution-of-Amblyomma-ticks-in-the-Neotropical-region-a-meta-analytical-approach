# Calculating the r value
r = (ambiente$yi) /
  (sqrt((ambiente$yi)^2 + 
          (((ambiente$n_tickseca + ambiente$n_tickchuvosa)^2)/
             (ambiente$n_tickseca*ambiente$n_tickchuvosa))))
summary(r)
# Calculating Zr
Zr = 0.5 * log((1 + r) / (1 - r))
summary(Zr)
hist(Zr)
